# EcoTrace Engine - Environment Variables Configuration

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="EcoTrace Engine"
APP_VERSION="0.1.0"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8081

# Database (PostgreSQL 16)
# REQUIRED: set strong credentials outside of source control
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecotrace_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ecotrace_db

# Redis 7 (Cache & Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/0

# RabbitMQ 3 (Broker & DLX)
# REQUIRED: RABBITMQ_USER / RABBITMQ_PASSWORD must be provided
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5673//

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5673//
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# SEFAZ Integration (Mock / Resilient Client)
SEFAZ_MOCK_ENABLED=true
SEFAZ_TIMEOUT_SECONDS=5.0
SEFAZ_MAX_RETRIES=3
SEFAZ_CIRCUIT_BREAKER_FAIL_MAX=5
SEFAZ_CIRCUIT_BREAKER_RESET_TIMEOUT=30

# Observability (OpenTelemetry & Prometheus)
OTEL_SERVICE_NAME=ecotrace-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
